# ---- 密钥与凭据：绝不入库 ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# ---- Python 环境与缓存 ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ---- 生成物与运行产物 ----
outputs/
runs/
artifacts/
tmp/

# ---- 模型权重与数据集：只提交 manifest ----
models/**
!models/manifest.yaml
datasets/**
!datasets/manifest.yaml

# ---- 常见权重/数据格式兜底 ----
*.pt
*.pth
*.safetensors
*.ckpt
*.onnx
*.h5
*.gguf
*.parquet
*.arrow
*.tar
*.tar.gz
*.zip

# ---- 编辑器与系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 本地临时文件 ----
*.local
.tmp-*
